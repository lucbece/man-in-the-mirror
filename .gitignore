node_modules/
.env
data/
sounds/*
!sounds/README.md

# Raw clips staged for `npm run prep`
incoming/*
!incoming/README.md

# Audio, anywhere in the tree. The clips are copyrighted recordings — fine on
# your own disk, not something to publish. Belt and braces alongside the
# sounds/ and incoming/ rules above, so a stray download in the project root
# can't get swept into a commit.
*.mp3
*.wav
*.ogg
*.oga
*.opus
*.m4a
*.aac
*.flac
*.webm
*.log

# Node downloaded by the launcher when the machine has none
runtime/

# Compiled launcher binaries — rebuild with launcher/build.sh
dist/
.gstack/
