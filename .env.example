# Optional: the control panel writes these into data/config.json instead.
# Values saved through the UI take precedence over anything set here.

# Bot token from https://discord.com/developers/applications → Bot → Reset Token
DISCORD_TOKEN=

# Optional: register slash commands instantly on one server instead of globally
DISCORD_GUILD_ID=

# Random gap between sounds
MIN_INTERVAL_SECONDS=30
MAX_INTERVAL_SECONDS=120

# 0.0 – 2.0
VOLUME=0.6

# Control panel
WEB_PORT=3000
WEB_HOST=127.0.0.1
