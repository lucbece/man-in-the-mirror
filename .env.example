# Copy to .env and fill in. The control panel writes the same values into
# data/config.json, and anything saved there wins over what's here.
#
# Three keys are all it takes. Everything below them has a working default.

# 1. Bot token — https://discord.com/developers/applications → Bot → Reset Token
DISCORD_TOKEN=

# 2. Hearing and speaking — https://platform.openai.com/api-keys
#    Transcription and the voice. Only optional if you switch both to run on
#    your own machine in the panel.
OPENAI_API_KEY=

# 3. Thinking — https://console.anthropic.com/settings/keys
#    The agent brain runs on this. It needs credit on the account, not just a
#    valid key.
ANTHROPIC_API_KEY=

# Strongly recommended: your server's id, so slash commands appear immediately.
# Without it Discord registers them globally, which can take an hour to show up.
# Right-click the server → Copy Server ID (needs Developer Mode turned on).
DISCORD_GUILD_ID=

# --- everything below is optional --------------------------------------------

# How much conversation to hold in memory, in seconds
BUFFER_SECONDS=90

# Control panel. It has no authentication of its own, so only expose it beyond
# localhost behind something that does.
WEB_PORT=3000
WEB_HOST=127.0.0.1
